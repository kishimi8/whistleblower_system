# ====================================================
# Whistleblower Production Environment Configuration
# ====================================================

# Django Core
SECRET_KEY=generate-a-secure-random-secret-key-for-production
DEBUG=False
ALLOWED_HOSTS=whistle.finance.gov.ng,localhost,127.0.0.1,web-app-1,web-app-2,web-app-3,nginx
CSRF_TRUSTED_ORIGINS=https://whistle.finance.gov.ng,http://localhost,https://localhost

# Database Configuration
DB_NAME=whistle
DB_USER=postgres
DB_PASSWORD=change_this_to_a_strong_database_password
DB_HOST=db-primary
DB_PORT=5432

# PostgreSQL Streaming Replication Credentials
REPLICATION_USER=replicator
REPLICATION_PASSWORD=change_this_to_a_strong_replication_password

# Redis Configuration
REDIS_PASSWORD=change_this_to_a_strong_redis_password
REDIS_URL=redis://:change_this_to_a_strong_redis_password@redis:6379/1

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.entuitivesupport.com.ng
EMAIL_PORT=465
EMAIL_USE_TLS=True
EMAIL_HOST_USER=kishimi@entuitivesupport.com.ng
EMAIL_HOST_PASSWORD=change_email_password
